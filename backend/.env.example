# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed (NFR-01).
#
# Neon gives you a libpq URI in the console:
#
#     postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#
# JDBC will not accept that string. Convert it:
#   1. prefix the URL with `jdbc:`
#   2. take USER and PASSWORD out of the URL into their own variables below
#   3. use the DIRECT host, not the `-pooler` one -- Flyway's locking needs it

DB_URL=jdbc:postgresql://ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
